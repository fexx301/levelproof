# LevelProof model gateway — copy to .env and fill in real values.
# Real keys are never committed (see .gitignore); placeholders only.
# Model choice per docs/model-eval.md (evaluated 2026-09-11).
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-...
LLM_MODEL=google/gemini-3.8-flash
LLM_FALLBACK_MODEL=google/gemini-2.5-flash-lite
# Streamed from-scratch builds typically finish in 5-12 s on gemini-3.8-flash
# (low reasoning effort); 45 s still fits the 52 s service deadline.
LLM_TIMEOUT_MS=45000
PUBLIC_URL=https://levelproof.vercel.app
# Production API calls fail closed unless shared request protection is configured.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
API_RATE_LIMIT_WINDOW_SECONDS=60
API_RATE_LIMIT_REQUESTS=8
API_DAILY_REQUEST_LIMIT=300
# Shared compile/explain cache (uses the Upstash credentials above). Stores the
# full request identity (including the prompt) and result for this many seconds.
SHARED_CACHE_TTL_SECONDS=604800
# Set to "off" to keep the cache instance-local only.
LEVELPROOF_SHARED_CACHE=on
